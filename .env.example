# Copy these into your Vercel project's Environment Variables (Settings → Environment Variables).
# Do NOT commit real keys.

# --- AI chat (Ask tab) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Optional: override the model. Defaults to claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Suggestions email (Suggest tab) ---
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxx
# Where suggestions are emailed (comma-separate for multiple recipients).
SUGGEST_TO=rules@sfltx.org
# The "from" address. Must be a domain you've verified in Resend.
# Until you verify a domain you can use Resend's test sender below.
SUGGEST_FROM=SFL Rules App <onboarding@resend.dev>
