# Copy these into your Vercel project's Environment Variables (Settings → Environment Variables).
# Do NOT commit real keys.

# --- AI chat (Ask tab) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxx
# Optional: override the model. Defaults to claude-sonnet-4-5.
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Suggestions email (Suggest tab), via Web3Forms ---
# Your access key from web3forms.com. Suggestions are emailed to the inbox
# configured on your Web3Forms account (no separate "to" address needed here).
WEB3FORMS_ACCESS_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
